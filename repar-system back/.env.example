DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données : sqlite par défaut. Pour PostgreSQL, passer DB_ENGINE à postgresql
# et renseigner les paramètres ci-dessous dans le fichier .env local.
DB_ENGINE=sqlite
DB_NAME=reparsystem
DB_USER=reparsystem
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONN_MAX_AGE=60

HUGGINGFACE_API_TOKEN=hf_votre_token_ici
HUGGINGFACE_DIAGNOSTIC_MODEL=meta-llama/Llama-3.1-8B-Instruct
# URL de production : /webhook. Pour un essai manuel dans n8n, employer
# temporairement /webhook-test pendant que le bouton "Listen for test event" est actif.
N8N_NOTIFICATION_WEBHOOK_URL=http://localhost:5678/webhook/repar-system-notification
