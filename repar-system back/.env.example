DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données : sqlite par défaut. Pour PostgreSQL, passer DB_ENGINE à postgresql
# et renseigner les paramètres ci-dessous dans le fichier .env local.
DB_ENGINE=sqlite
DB_NAME=reparsystem
DB_USER=reparsystem
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONN_MAX_AGE=60

OPENROUTER_API_KEY=sk-or-v1-remplacer-par-votre-cle
OPENROUTER_DIAGNOSTIC_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=http://localhost:5173
OPENAI_API_KEY=sk-remplacer-par-votre-cle
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# URL de production : /webhook. Pour un essai manuel dans n8n, employer
# temporairement /webhook-test pendant que le bouton "Listen for test event" est actif.
N8N_NOTIFICATION_WEBHOOK_URL=http://localhost:5678/webhook/repar-system-notification
